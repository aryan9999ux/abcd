# Supabase project "prop-f". These two are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
KITE_API_KEY=
KITE_API_SECRET=

# demo | zerodha
PRICE_SOURCE=demo

# Trading engine
# Secret for the scheduled tick endpoint /api/engine/tick (send as a header). Optional in dev.
ENGINE_SECRET=
# dev: checkout marks purchases paid instantly (no real payment). Replace with a gateway before launch.
PAYMENTS_MODE=dev

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=
